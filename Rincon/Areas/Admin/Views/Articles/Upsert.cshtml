@model Rincon.Models.ViewModels.ArticleVM

@{
    ViewData["Title"] = Model.Article.Id == 0 ? "Crear Artículo" : "Editar Artículo";
    var selectedCategory = Model.CategoryList.FirstOrDefault(c => c.Value == Model.Article.CategoryId.ToString());
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
}

<form method="post" asp-action="Upsert" enctype="multipart/form-data">
    <input asp-for="Article.Id" hidden />
    <input asp-for="Article.ImageUrl" hidden />
    <input asp-for="Article.Date" hidden />
    <input asp-for="Article.UnitOfMeasure" hidden id="unitOfMeasureInput" />

    <div class="admin-page py-4">
        <div class="admin-hero mb-4 d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="fa fa-box-open"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Artículos</span>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="admin-title h3 mb-1">
                        @(Model.Article.Id == 0 ? "Crear artículo" : "Editar artículo")
                    </h1>
                    @await Html.PartialAsync("~/Views/Shared/_ScreenHelp.cshtml", new Rincon.Models.ViewModels.ScreenHelpVM
                    {
                        Title = "Formulario de artículo",
                        Description = "Cargá los datos necesarios para que el producto funcione correctamente en ventas y reportes.",
                        Items = new[] { "El código se usa para escanear o buscar rápido en el carrito.", "Precio es lo que paga el cliente; costo se usa para calcular ganancia.", "Elegí si la venta se calcula por kilogramo o por unidad.", "La imagen y el vencimiento ayudan al operador, pero pueden quedar vacíos si no aplican." }
                    })
                </div>
                <p class="admin-subtitle mb-0">Cargá producto, precio, stock, vencimiento e imagen.</p>
            </div>
        </div>

        <div class="form-card">
            <div class="mb-4">
                <span class="section-kicker">Datos principales</span>
                <h2 class="section-title mb-0">Información del artículo</h2>
            </div>

            <div>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-8">

                        <div class="mb-3">
                            <label asp-for="Article.Name" class="form-label"></label>
                            <input asp-for="Article.Name" class="form-control" placeholder="Ingrese el nombre del artículo" />
                            <span asp-validation-for="Article.Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Article.Description" class="form-label"></label>
                            <textarea asp-for="Article.Description" class="form-control" rows="3" placeholder="Ingrese una descripción"></textarea>
                            <span asp-validation-for="Article.Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Article.Code" class="form-label"></label>
                                <input asp-for="Article.Code" class="form-control" placeholder="Código de barras o código interno" />
                                <span asp-validation-for="Article.Code" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Article.CategoryId" class="form-label"></label>
                                <select asp-for="Article.CategoryId"
                                        class="form-select category-search-select"
                                        data-placeholder="Seleccione una categoría">
                                    @if (selectedCategory != null)
                                    {
                                        <option value="@selectedCategory.Value" selected>@selectedCategory.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="Article.CategoryId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <input asp-for="Article.IsSoldByWeight"
                                       class="visually-hidden"
                                       type="checkbox"
                                       id="isSoldByWeightSwitch" />

                                <label class="form-label d-block">Tipo de venta</label>
                                <div class="article-sale-mode-toggle" role="group" aria-label="Tipo de venta del artículo">
                                    <button type="button"
                                            class="article-sale-mode-option"
                                            data-weight-mode="true"
                                            aria-pressed="false">
                                        Venta por kilogramo
                                    </button>
                                    <button type="button"
                                            class="article-sale-mode-option"
                                            data-weight-mode="false"
                                            aria-pressed="false">
                                        Venta por unidad
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <input asp-for="Article.UsesBatches"
                                       class="visually-hidden"
                                       type="checkbox"
                                       id="usesBatchesSwitch" />

                                <label class="form-label d-block">Control de stock</label>
                                <div class="article-sale-mode-toggle article-stock-mode-toggle" role="group" aria-label="Control de stock del artículo">
                                    <button type="button"
                                            class="article-sale-mode-option"
                                            data-batch-mode="false"
                                            aria-pressed="false">
                                        Stock simple
                                    </button>
                                    <button type="button"
                                            class="article-sale-mode-option"
                                            data-batch-mode="true"
                                            aria-pressed="false">
                                        Stock por lotes
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PriceText" class="form-label" id="priceLabel">
                                    Precio de venta por unidad
                                </label>
                                <input asp-for="PriceText"
                                       class="form-control"
                                       placeholder="$ 0,00"
                                       inputmode="decimal"
                                       autocomplete="off" />
                                <span asp-validation-for="PriceText" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="CostText" class="form-label" id="costLabel">
                                    Costo por unidad
                                </label>
                                <input asp-for="CostText"
                                       class="form-control"
                                       placeholder="$ 0,00"
                                       inputmode="decimal"
                                       autocomplete="off" />
                                <span asp-validation-for="CostText" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3 stock-simple-field">
                                <label asp-for="StockText" class="form-label" id="stockLabel">
                                    Stock en unidades
                                </label>
                                <input asp-for="StockText"
                                       class="form-control"
                                       placeholder="Stock disponible"
                                       inputmode="decimal"
                                       autocomplete="off" />
                                <span asp-validation-for="StockText" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="StockMinText" class="form-label" id="stockMinLabel">
                                    Stock mínimo en unidades
                                </label>
                                <input asp-for="StockMinText"
                                       class="form-control"
                                       placeholder="Stock mínimo"
                                       inputmode="decimal"
                                       autocomplete="off" />
                                <span asp-validation-for="StockMinText" class="text-danger"></span>
                            </div>
                        </div>

                                                
                        <div class="row">

                            <div class="col-md-6 mb-3 stock-simple-field">
                                <label asp-for="Article.ExpirationDate" class="form-label"></label>
                                <input asp-for="Article.ExpirationDate" type="date" class="form-control" />
                                <span asp-validation-for="Article.ExpirationDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Imagen del artículo</label>
                                <input type="file" name="files" id="uploadBox" class="form-control" accept="image/*" />
                            </div>

                        </div>
                       
                        <div class="mb-3">
                            <label asp-for="Article.isActive" class="form-label"></label>

                            <div class="form-check form-switch">
                                <input asp-for="Article.isActive"
                                       class="form-check-input admin-switch"
                                       type="checkbox"
                                       role="switch"
                                       id="isActiveSwitch" />

                                <label class="form-check-label fw-bold admin-switch-label" id="isActiveLabel" for="isActiveSwitch">
                                    @(Model.Article.isActive ? "Activo" : "Inactivo")
                                </label>
                            </div>
                        </div>

                    </div>

                    <div class="col-md-4 text-center">
                        <img id="imagePreview"
                             src="@(string.IsNullOrEmpty(Model.Article.ImageUrl) ? "" : Model.Article.ImageUrl)"
                             class="article-preview-img mb-3 @(string.IsNullOrEmpty(Model.Article.ImageUrl) ? "d-none" : "")" />

                        <div id="noImageText"
                             class="image-empty-state mb-3 @(!string.IsNullOrEmpty(Model.Article.ImageUrl) ? "d-none" : "")">
                            Sin imagen cargada
                        </div>

                        <div class="custom-alert-info text-start mt-3">
                            <strong>Referencia:</strong>
                            <div id="unitHelpText">
                                Este producto se vende por unidad. El precio y el costo corresponden a cada producto individual.
                            </div>
                        </div>

                        <div class="custom-alert-warning text-start mt-3">
                            <strong>Importante:</strong>
                            <div>
                                Si el artículo corresponde a uno o varios lotes, seleccioná Stock por lotes. En ese modo el stock y la fecha de vencimiento se cargan desde cada lote. El stock mínimo queda como alerta general del artículo. <strong>Luego de crear el artículo, agregá los lotes correspondientes.</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mt-3">
                    <div class="col-6">
                        <button type="submit" class="btn btn-primary btn-modern w-100">
                            @(Model.Article.Id == 0 ? "Crear" : "Actualizar")
                        </button>
                    </div>

                    <div class="col-6">
                        <a asp-area="Admin" asp-controller="Articles" asp-action="Index" class="btn btn-soft-secondary w-100">
                            Volver
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const categorySelect = $(".category-search-select");

            if (categorySelect.length) {
                categorySelect.select2({
                    theme: "bootstrap-5",
                    width: "100%",
                    placeholder: categorySelect.data("placeholder") || "Seleccione una categoría",
                    allowClear: true,
                    minimumInputLength: 0,
                    ajax: {
                        url: "/Admin/Category/Search",
                        dataType: "json",
                        delay: 200,
                        data: function (params) {
                            return {
                                term: params.term || "",
                                page: params.page || 1
                            };
                        },
                        processResults: function (data) {
                            return data;
                        }
                    },
                    language: {
                        inputTooShort: function () {
                            return "Escribí para buscar";
                        },
                        searching: function () {
                            return "Buscando...";
                        },
                        loadingMore: function () {
                            return "Cargando más...";
                        },
                        noResults: function () {
                            return "Sin resultados";
                        }
                    }
                });
            }

            // =========================
            // SWITCH ACTIVO / INACTIVO
            // =========================
            const activeSwitch = document.getElementById("isActiveSwitch");
            const activeLabel = document.getElementById("isActiveLabel");

            function updateActiveSwitchLabel() {
                if (!activeSwitch || !activeLabel) {
                    return;
                }

                if (activeSwitch.checked) {
                    activeLabel.textContent = "Activo";
                    activeLabel.classList.remove("text-danger");
                    activeLabel.classList.add("text-success");
                } else {
                    activeLabel.textContent = "Inactivo";
                    activeLabel.classList.remove("text-success");
                    activeLabel.classList.add("text-danger");
                }
            }

            updateActiveSwitchLabel();

            if (activeSwitch) {
                activeSwitch.addEventListener("change", updateActiveSwitchLabel);
            }


            // =========================
            // SWITCH POR PESO / UNIDAD
            // =========================
            const weightSwitch = document.getElementById("isSoldByWeightSwitch");
            const saleModeButtons = document.querySelectorAll("[data-weight-mode]");
            const unitOfMeasureInput = document.getElementById("unitOfMeasureInput");
            const unitHelpText = document.getElementById("unitHelpText");

            const priceLabel = document.getElementById("priceLabel");
            const costLabel = document.getElementById("costLabel");
            const stockLabel = document.getElementById("stockLabel");
            const stockMinLabel = document.getElementById("stockMinLabel");
            const usesBatchesSwitch = document.getElementById("usesBatchesSwitch");
            const batchModeButtons = document.querySelectorAll("[data-batch-mode]");
            const stockSimpleFields = document.querySelectorAll(".stock-simple-field");
            const stockInput = document.getElementById("StockText");
            const expirationInput = document.getElementById("Article_ExpirationDate");

            function updateWeightMode() {
                if (!weightSwitch || !unitOfMeasureInput) {
                    return;
                }

                if (weightSwitch.checked) {
                    unitOfMeasureInput.value = "Kilogramo";

                    if (priceLabel) priceLabel.textContent = "Precio de venta por kilogramo";
                    if (costLabel) costLabel.textContent = "Costo por kilogramo";
                    if (stockLabel) stockLabel.textContent = "Stock en kilogramos";
                    if (stockMinLabel) stockMinLabel.textContent = "Stock mínimo en kilogramos";

                    if (unitHelpText) {
                        unitHelpText.innerText = "Este producto se vende por kg. Cargá precio, costo y stock tomando como referencia el kilogramo.";
                    }
                } else {
                    unitOfMeasureInput.value = "Unidad";

                    if (priceLabel) priceLabel.textContent = "Precio de venta por unidad";
                    if (costLabel) costLabel.textContent = "Costo por unidad";
                    if (stockLabel) stockLabel.textContent = "Stock en unidades";
                    if (stockMinLabel) stockMinLabel.textContent = "Stock mínimo en unidades";

                    if (unitHelpText) {
                        unitHelpText.innerText = "Este producto se vende por unidad. El precio y el costo corresponden a cada producto individual.";
                    }
                }

                saleModeButtons.forEach(function (button) {
                    const isSelected = button.dataset.weightMode === String(weightSwitch.checked);

                    button.classList.toggle("active", isSelected);
                    button.setAttribute("aria-pressed", String(isSelected));
                });
            }

            updateWeightMode();

            if (weightSwitch) {
                weightSwitch.addEventListener("change", updateWeightMode);
            }

            saleModeButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    if (!weightSwitch) {
                        return;
                    }

                    weightSwitch.checked = button.dataset.weightMode === "true";
                    weightSwitch.dispatchEvent(new Event("change", { bubbles: true }));
                });
            });

            // =========================
            // STOCK SIMPLE / LOTES
            // =========================
            function updateBatchMode() {
                if (!usesBatchesSwitch) {
                    return;
                }

                const usesBatches = usesBatchesSwitch.checked;

                stockSimpleFields.forEach(function (field) {
                    field.classList.toggle("d-none", usesBatches);
                });

                if (stockInput) {
                    stockInput.disabled = usesBatches;

                    if (usesBatches) {
                        stockInput.value = "";
                    }
                }

                if (expirationInput) {
                    expirationInput.disabled = usesBatches;

                    if (usesBatches) {
                        expirationInput.value = "";
                    }
                }

                batchModeButtons.forEach(function (button) {
                    const isSelected = button.dataset.batchMode === String(usesBatches);

                    button.classList.toggle("active", isSelected);
                    button.setAttribute("aria-pressed", String(isSelected));
                });
            }

            updateBatchMode();

            if (usesBatchesSwitch) {
                usesBatchesSwitch.addEventListener("change", updateBatchMode);
            }

            batchModeButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    if (!usesBatchesSwitch) {
                        return;
                    }

                    usesBatchesSwitch.checked = button.dataset.batchMode === "true";
                    usesBatchesSwitch.dispatchEvent(new Event("change", { bubbles: true }));
                });
            });

            // =========================
            // PREVISUALIZACIÓN DE IMAGEN
            // =========================
            const uploadBox = document.getElementById("uploadBox");
            const imagePreview = document.getElementById("imagePreview");
            const noImageText = document.getElementById("noImageText");

            if (uploadBox && imagePreview) {
                uploadBox.addEventListener("change", function () {
                    const file = this.files[0];

                    if (!file) {
                        return;
                    }

                    if (!file.type.startsWith("image/")) {
                        toastr.error("Debe seleccionar un archivo de imagen válido");
                        uploadBox.value = "";
                        return;
                    }

                    const imageUrl = URL.createObjectURL(file);

                    imagePreview.src = imageUrl;
                    imagePreview.classList.remove("d-none");

                    if (noImageText) {
                        noImageText.classList.add("d-none");
                    }
                });
            }
        });
    </script>
}
