@{
    ViewData["Title"] = "Artículos";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-6">
            <h2 class="text-primary">Lista de Artículos</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-area="Admin" asp-controller="Articles" asp-action="Upsert" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Crear nuevo artículo
            </a>
        </div>
    </div>

    <table id="tblArticles" class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>Código</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Costo</th>
                <th>Stock</th>
                <th>Vencimiento</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <script src="~/js/article.js"></script>
}