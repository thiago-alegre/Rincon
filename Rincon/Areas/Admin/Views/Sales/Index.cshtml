@{
    ViewData["Title"] = "Historial de ventas";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="text-primary fw-bold text-uppercase small">Administración</span>
            <h1 class="h3 fw-bold mb-1">Historial de ventas</h1>
            <p class="text-muted mb-0">Consultá las ventas realizadas y el empleado que las registró.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">
            <div class="table-responsive">
                <table id="salesTable" class="table table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Medio de pago</th>
                            <th>Total</th>
                            <th>Empleado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sale.js"></script>
}