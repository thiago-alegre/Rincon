@{
    ViewData["Title"] = "Historial de ventas";
}

<div class="admin-page py-4">
    <div class="admin-hero mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="fa fa-receipt"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Administración</span>
                <h1 class="admin-title h3 mb-1">Historial de ventas</h1>
                <p class="admin-subtitle mb-0">Consultá las ventas realizadas y el usuario que las registró.</p>
            </div>
        </div>
    </div>

    <div class="content-card">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
            <div>
                <span class="section-kicker">Listado</span>
                <h2 class="section-title mb-0">Ventas registradas</h2>
            </div>
        </div>

        <div class="table-responsive custom-table-wrapper">
            <table id="salesTable" class="table custom-table mb-0 w-100">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Medio de pago</th>
                        <th>Total</th>
                        <th>Usuario</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sale.js" asp-append-version="true"></script>
}
