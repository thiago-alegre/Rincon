@model Rincon.Models.Sale

@{
    ViewData["Title"] = "Detalle de venta";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="text-primary fw-bold text-uppercase small">Venta #@Model.Id</span>
            <h1 class="h3 fw-bold mb-1">Detalle de venta</h1>
            <p class="text-muted mb-0">
                Registrada el @Model.Date.ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>

        <a asp-area="Admin" asp-controller="Sales" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">Total</div>
                    <div class="fs-3 fw-bold text-success">$ @Model.Total.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">Medio de pago</div>
                    <div class="fs-5 fw-bold">@Model.PaymentMethod</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">Empleado</div>
                    <div class="fs-6 fw-bold">
                        @(Model.User != null ? Model.User.Email : "Sin usuario")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">
            <h2 class="h5 fw-bold mb-3">Productos vendidos</h2>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Código</th>
                            <th>Cantidad</th>
                            <th>Precio unitario</th>
                            <th>Unidad</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SaleDetails)
                        {
                            <tr>
                                <td>@item.ArticleName</td>
                                <td>@item.ArticleCode</td>
                                <td>@item.Quantity.ToString("N2")</td>
                                <td>$ @item.UnitPrice.ToString("N2")</td>
                                <td>@item.UnitOfMeasure</td>
                                <td class="text-end fw-bold">$ @item.Subtotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>