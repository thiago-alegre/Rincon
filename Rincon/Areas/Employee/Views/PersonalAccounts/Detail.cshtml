@model Rincon.Models.ViewModels.PersonalAccountDetailVM

@{
    ViewData["Title"] = "Detalle de cuenta personal";
    var canVoidPayments = (bool?)ViewBag.CanVoidPayments ?? false;
}

<div class="admin-page py-4">
    <div class="admin-hero mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="bi bi-person-lines-fill"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Cuenta personal</span>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="admin-title h3 mb-1">@Model.Account.FullName</h1>
                    @await Html.PartialAsync("~/Views/Shared/_ScreenHelp.cshtml", new Rincon.Models.ViewModels.ScreenHelpVM
                    {
                        Title = "Detalle de cuenta personal",
                        Description = "Revisá deuda, ventas asociadas y pagos registrados para esta persona.",
                        Items = new[] { "Registrar pago permite saldar total o parcialmente la deuda.", "Las ventas pendientes muestran artículos, fechas y valores.", "Los pagos quedan registrados para controlar cuándo y cuánto abonó." }
                    })
                </div>
                <p class="admin-subtitle mb-0">DNI @Model.Account.DNI · @(Model.Account.Phone ?? "Sin teléfono")</p>
            </div>
        </div>

        <a asp-area="Employee" asp-controller="PersonalAccounts" asp-action="Index" class="btn btn-soft-secondary">
            <i class="fa fa-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Deuda actual</div>
                <div class="detail-metric-value text-danger">$ @Model.CurrentDebt.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Adeuda desde</div>
                <div class="detail-metric-value">@(Model.DebtSince.HasValue ? Model.DebtSince.Value.ToString("dd/MM/yyyy") : "-")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Dirección</div>
                <div class="detail-metric-value">@(Model.Account.Address ?? "-")</div>
            </div>
        </div>
    </div>

    @if (Model.CurrentDebt > 0)
    {
        <div class="content-card mb-4">
            <form asp-area="Employee" asp-controller="PersonalAccounts" asp-action="Settle" method="post" class="personal-account-settle-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Account.Id" />
                <div>
                    <span class="section-kicker">Cobro</span>
                    <h2 class="section-title mb-0">Registrar pago de cuenta</h2>
                    <p class="text-muted mb-0">Si el monto queda vacío, se registra el total pendiente.</p>
                </div>
                <select name="PaymentMethod" class="form-select">
                    <option value="Efectivo">Efectivo</option>
                    <option value="Transferencia">Transferencia</option>
                </select>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input name="AmountText"
                           class="form-control"
                           inputmode="decimal"
                           autocomplete="off"
                           placeholder="Monto abonado" />
                </div>
                <input name="Notes" class="form-control" placeholder="Observación opcional" maxlength="500" />
                <button type="submit" class="btn btn-success btn-modern">
                    <i class="fa fa-check me-1"></i> Registrar pago
                </button>
            </form>
        </div>
    }

    <div class="content-card">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
            <div>
                <span class="section-kicker">Ventas</span>
                <h2 class="section-title mb-0">Artículos vendidos a esta cuenta</h2>
            </div>
        </div>

        <div class="table-responsive custom-table-wrapper">
            <table id="personalAccountSaleDetailsTable"
                   class="table custom-table mb-0 w-100"
                   data-account-id="@Model.Account.Id">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Venta</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio</th>
                        <th>Subtotal</th>
                        <th>Estado</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>

    <div class="content-card mt-4">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
            <div>
                <span class="section-kicker">Cobros</span>
                <h2 class="section-title mb-0">Pagos registrados</h2>
            </div>
        </div>

        <div class="table-responsive custom-table-wrapper">
            <table id="personalAccountPaymentsTable"
                   class="table custom-table mb-0 w-100"
                   data-account-id="@Model.Account.Id">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Medio</th>
                        <th>Monto</th>
                        <th>Caja</th>
                        <th>Usuario</th>
                        <th>Observación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@if (canVoidPayments)
{
    <div class="modal fade screen-help-modal"
         id="voidPersonalAccountPaymentModal"
         tabindex="-1"
         aria-labelledby="voidPersonalAccountPaymentModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content screen-help-content">
                <div class="modal-header screen-help-header">
                    <div>
                        <span class="section-kicker">Anulación</span>
                        <h2 class="modal-title screen-help-title" id="voidPersonalAccountPaymentModalLabel">
                            Anular pago de cuenta personal
                        </h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <form asp-area="Employee" asp-controller="PersonalAccounts" asp-action="VoidPayment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="voidPaymentId" name="id" />

                    <div class="modal-body screen-help-body">
                        <p class="screen-help-description mb-3">
                            El pago permanecerá en el historial como anulado y la deuda de la cuenta será recalculada.
                        </p>

                        <div class="alert alert-warning border-warning-subtle">
                            <div><strong id="voidPaymentAmount"></strong></div>
                            <div id="voidPaymentMethod" class="small"></div>
                            <div id="voidPaymentCashRegister" class="small"></div>
                        </div>

                        <div id="returnedCashContainer" class="form-check mb-3 d-none">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="deductReturnedCashFromCounted"
                                   name="deductReturnedCashFromCounted"
                                   value="true" />
                            <label class="form-check-label" for="deductReturnedCashFromCounted">
                                El efectivo fue devuelto al cliente o retirado de la caja. Descontarlo del efectivo contado si la caja ya está cerrada.
                            </label>
                        </div>

                        <label for="voidPaymentReason" class="form-label fw-semibold">Motivo</label>
                        <textarea id="voidPaymentReason"
                                  name="reason"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"
                                  required
                                  placeholder="Ej: pago registrado por error"></textarea>
                    </div>

                    <div class="modal-footer screen-help-footer">
                        <button type="button" class="btn btn-soft-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-soft-danger">
                            <i class="fa fa-ban me-1"></i> Sí, anular pago
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/personalAccountDetail.js" asp-append-version="true"></script>
}
